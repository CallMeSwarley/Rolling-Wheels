# This .htaccess file belongs in /rumprobiert on server

# Disable directory listing for security reasons
Options -Indexes

# Default file to serve when a directory is requested
DirectoryIndex index.html

# Ensure Apache adds a trailing slash when a directory
# is requested without one (e.g. /calendar → /calendar/)
# This issues a proper 301 redirect automatically
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect directory requests without trailing slash
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

    # Serve existing files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule . - [L]
</IfModule>

